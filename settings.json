{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "Bash(*setup-ralph-loop*)",
      "Bash(LEFTHOOK=0*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/secrets/**)",
      "Read(**/*credentials*.json)",
      "Read(**/*token*.json)",
      "Read(**/*token*.txt)",
      "Read(**/*token*.key)",
      "Read(**/*token*.pem)",
      "Read(**/*token*.env)",
      "Read(**/*token*.yaml)",
      "Read(**/*token*.yml)",
      "Read(**/.token)",
      "Read(**/.token.*)",
      "Read(**/*.token)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Bash(docker compose down -v)",
      "Bash(docker compose down --volumes)",
      "Bash(docker-compose down -v)",
      "Bash(git reset --hard)",
      "Bash(git clean -fd)",
      "Bash(git clean -fdx)",
      "Bash(git push --force)",
      "Bash(git push -f)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/penis/.bun/bin/bun \"/home/penis/.claude/hooks/project-structure.mjs\" --hook 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Building project tree..."
          },
          {
            "type": "command",
            "command": "/home/penis/.bun/bin/bun \"/home/penis/.claude/hooks/injection-rules-sessionstart.mjs\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/penis/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/penis/.bun/bin/bun \"/home/penis/.claude/hooks/injection-rules-subagentstart.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/penis/.bun/bin/bun /home/penis/.claude/hooks/lint-inject-posttoolbatch.mjs",
            "timeout": 15,
            "statusMessage": "Linting..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/penis/.bun/bin/bun /home/penis/.claude/hooks/injection-rules-posttooluse.mjs 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/penis/.bun/bin/bun /home/penis/.claude/hooks/injection-rules-userprompt.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/penis/.bun/bin/bun /home/penis/.claude/hooks/injection-rules-stop.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/penis/.bun/bin/bun \"/home/penis/.claude/hooks/injection-rules-postcompact.mjs\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "context-mode@context-mode": false,
    "ponytail@ponytail": false,
    "context7@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "codebase-project-graph@project-graph-local": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "project-graph-local": {
      "source": {
        "source": "directory",
        "path": "/home/penis/plugins/claude-codebase-project-graph"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "autoCompactWindow": 600000,
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "~/.claude/memory",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
